{
  "name": "math-comments",
  "displayName": "Math Comments",
  "description": "Renders LaTeX written inside code comments ($...$, $$...$$, \\(...\\), \\[...\\]) directly in the editor.",
  "publisher": "husimi",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "engines": { "vscode": "^1.90.0" },
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "scripts": {
    "build": "esbuild src/extension.js --bundle --platform=node --target=node18 --format=cjs --external:vscode --minify --outfile=dist/extension.js",
    "test": "node --test test/"
  },
  "dependencies": { "mathjax-full": "3.2.2" },
  "devDependencies": { "esbuild": "0.28.2" }
}
