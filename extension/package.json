{
  "name": "remote-sessions",
  "displayName": "Remote Sessions",
  "description": "Lists the running Claude remote-control sessions on this host and keeps their projects open as workspace folders.",
  "publisher": "husimi",
  "version": "0.5.2",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:remoteSessions.home"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remoteSessions",
          "title": "Remote Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "remoteSessions": [
        {
          "id": "remoteSessions.tree",
          "name": "Running sessions"
        },
        {
          "type": "webview",
          "id": "remoteSessions.promptPanel",
          "name": "Sessions"
        }
      ],
      "explorer": [
        {
          "id": "remoteSessions.projects",
          "name": "Projects",
          "icon": "media/icon.svg"
        },
        {
          "type": "webview",
          "id": "remoteSessions.prompt",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "remoteSessions.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "remoteSessions.reveal",
        "title": "Show in Explorer"
      },
      {
        "command": "remoteSessions.watch",
        "title": "Open Terminal Window",
        "icon": "$(terminal)"
      },
      {
        "command": "remoteSessions.select",
        "title": "Show Sessions for Project"
      },
      {
        "command": "remoteSessions.projects.click",
        "title": "Select Project"
      },
      {
        "command": "remoteSessions.projects.open",
        "title": "Open Project",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remoteSessions.projects.back",
        "title": "Back to Projects",
        "icon": "$(arrow-left)"
      },
      {
        "command": "remoteSessions.home",
        "title": "Remote Sessions: Home",
        "icon": "$(home)"
      },
      {
        "command": "remoteSessions.launch",
        "title": "New Session",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "remoteSessions.launch",
          "when": "view == remoteSessions.tree",
          "group": "navigation@0"
        },
        {
          "command": "remoteSessions.refresh",
          "when": "view == remoteSessions.tree",
          "group": "navigation"
        },
        {
          "command": "remoteSessions.projects.back",
          "when": "view == remoteSessions.projects && remoteSessions.projectFocused",
          "group": "navigation@0"
        },
        {
          "command": "remoteSessions.home",
          "when": "view == remoteSessions.projects && !remoteSessions.projectFocused",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "remoteSessions.watch",
          "when": "view == remoteSessions.tree && viewItem == session",
          "group": "inline"
        },
        {
          "command": "remoteSessions.reveal",
          "when": "view == remoteSessions.tree && viewItem == project",
          "group": "navigation"
        },
        {
          "command": "remoteSessions.projects.open",
          "when": "view == remoteSessions.projects && viewItem == workspaceProject",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "remoteSessions.projects.click",
          "when": "false"
        },
        {
          "command": "remoteSessions.projects.open",
          "when": "false"
        },
        {
          "command": "remoteSessions.projects.back",
          "when": "remoteSessions.projectFocused"
        }
      ]
    },
    "configuration": {
      "title": "Remote Sessions",
      "properties": {
        "remoteSessions.pollSeconds": {
          "type": "number",
          "default": 15,
          "description": "How often to rescan running sessions."
        },
        "remoteSessions.includeLocal": {
          "type": "boolean",
          "default": true,
          "description": "Also list Claude sessions started without --remote-control."
        },
        "remoteSessions.syncWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Keep one workspace folder per running project."
        },
        "remoteSessions.excludeRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/",
            "~"
          ],
          "description": "Directories never added as workspace folders."
        },
        "remoteSessions.launchConfigDir": {
          "type": "string",
          "default": "/home/tr4m0ryp/.claude-cavum",
          "description": "CLAUDE_CONFIG_DIR for sessions started with New Session."
        }
      }
    }
  },
  "files": [
    "src/**",
    "media/**"
  ]
}
