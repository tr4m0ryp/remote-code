{
  "name": "remote-sessions",
  "displayName": "Remote Sessions",
  "description": "Lists the running Claude remote-control sessions on this host and keeps their projects open as workspace folders.",
  "publisher": "husimi",
  "version": "0.2.2",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remoteSessions",
          "title": "Remote Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "remoteSessions": [
        {
          "id": "remoteSessions.tree",
          "name": "Running sessions"
        },
        {
          "type": "webview",
          "id": "remoteSessions.promptPanel",
          "name": "This project"
        }
      ],
      "explorer": [
        {
          "type": "webview",
          "id": "remoteSessions.prompt",
          "name": "Claude Sessions",
          "initialSize": 4
        }
      ]
    },
    "commands": [
      {
        "command": "remoteSessions.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "remoteSessions.reveal",
        "title": "Show in Explorer"
      },
      {
        "command": "remoteSessions.watch",
        "title": "Watch Session (read-only terminal)",
        "icon": "$(eye)"
      },
      {
        "command": "remoteSessions.select",
        "title": "Show Sessions for Project"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "remoteSessions.refresh",
          "when": "view == remoteSessions.tree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "remoteSessions.watch",
          "when": "view == remoteSessions.tree && viewItem == session",
          "group": "inline"
        },
        {
          "command": "remoteSessions.reveal",
          "when": "view == remoteSessions.tree && viewItem == project",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Remote Sessions",
      "properties": {
        "remoteSessions.pollSeconds": {
          "type": "number",
          "default": 15,
          "description": "How often to rescan running sessions."
        },
        "remoteSessions.includeLocal": {
          "type": "boolean",
          "default": true,
          "description": "Also list Claude sessions started without --remote-control."
        },
        "remoteSessions.syncWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Keep one workspace folder per running project."
        },
        "remoteSessions.excludeRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/",
            "~"
          ],
          "description": "Directories never added as workspace folders."
        }
      }
    }
  },
  "files": [
    "src/**",
    "media/**"
  ]
}
